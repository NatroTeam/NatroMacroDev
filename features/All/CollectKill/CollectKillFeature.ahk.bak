#Requires AutoHotkey v2.0

global collectKillConfigLoc := "features\All\CollectKill\nm_collectkill_config.ini"

;this is this features GUI lines-of-code used to calculate loading progress
CollectKillFeatureProgressVolume := (CollectKillFeature) ? 218 : 0
;this is the running total of all macro features included in the load progress metric
LoadingProgressVolume := (CollectKillFeature) ? LoadingProgressVolume+CollectKillFeatureProgressVolume : LoadingProgressVolume


nm_includeCollectKillFeature(*){
	global
	nm_importCollectKillConfig()
}

