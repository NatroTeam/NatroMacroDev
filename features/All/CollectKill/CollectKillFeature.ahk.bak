		, "BugrunLadybugsLoot", "BugrunRhinoBeetlesLoot", "BugrunSpiderLoot", "BugrunMantisLoot", "BugrunScorpionsLoot", "BugrunWerewolfLoot"]

	for ctrl in ctrlList {
