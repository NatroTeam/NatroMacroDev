    (GuiCtrl := MainGui.Add("CheckBox", "x20 y120 w13 h13 vBugrunLadybugsLoot Disabled Hidden Checked" BugrunLadybugsLoot)).Section := "Collect", GuiCtrl.OnEvent("Click", nm_saveCollectKillConfig)
    (GuiCtrl := MainGui.Add("CheckBox", "xp yp+18 w13 h13 vBugrunRhinoBeetlesLoot Disabled Hidden Checked" BugrunRhinoBeetlesLoot)).Section := "Collect", GuiCtrl.OnEvent("Click", nm_saveCollectKillConfig)
